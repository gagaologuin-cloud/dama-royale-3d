{
 "hosting": {
  "public": "web",
  "ignore": [
   "firebase.json",
   "**/node_modules/**"
  ],
  "headers": [
   {
    "source": "/.well-known/assetlinks.json",
    "headers": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ]
   }
  ]
 },
 "functions": [
  {
   "source": "functions"
  }
 ],
 "database": {
  "rules": "database.rules.json"
 }
}